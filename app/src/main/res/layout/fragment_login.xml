<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_gray"
        tools:context=".view.fragment.Login">

        <!-- Botón centrado en la mitad de la pantalla -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieInventory"
            android:layout_width="320dp"
            android:layout_height="320dp"
            app:lottie_rawRes="@raw/inventory_login"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/login_inventory"
            android:layout_marginTop="20dp"
            android:layout_marginRight="-12dp"
        />

        <TextView
            android:id="@+id/login_inventory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Inventory"
            android:textColor="@color/red_orange"
            android:fontFamily="@font/lilitaone_regular"
            android:textSize="78sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lottieInventory"
            android:layout_marginTop="-82dp"
        />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieFingerprint"
            android:layout_width="220dp"
            android:layout_height="220dp"
            app:lottie_rawRes="@raw/fingerprint_login"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/login_inventory"
            android:layout_marginBottom="70dp"
        />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>